migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Local optional secrets (copy from lib/core/env/env.dart.example)
lib/core/env/env.dart

# Local audit exports/reports (never commit user data)
tools/exports/
tools/reports/

# Perf test capture outputs (written by test/perf_*.dart at repo root)
*_perf_capture.txt
shell_timeline_swipe_capture.txt
timeline_perf_capture.txt

# Ad-hoc local build/run logs (archive to docs/archive/ if worth keeping)
build_error.txt
perf_chrome_log.txt

# Android Gradle build outputs (must not be tracked)
android/build/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
installer/windows/output/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
