{
  "manifest_version": 3,
  "name": "LIFE OS",
  "version": "0.2.0",
  "description": "See the current LIFE OS record, start a new one, and open the web app.",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://nkuchenov-hash.github.io/Counter/*"
  ],
  "action": {
    "default_title": "LIFE OS",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open LIFE OS"
    }
  }
}
